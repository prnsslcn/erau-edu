# Supabase — 프로젝트 Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role 키 (절대 클라이언트에 노출 금지, 서버 전용)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 세션 쿠키 서명용 시크릿 (아래 명령으로 생성)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-chars

# Bunny Stream (영상 호스팅) — 서버 전용
# Stream → 라이브러리 → API 탭 / Security 탭에서 확인
BUNNY_STREAM_LIBRARY_ID=000000
BUNNY_STREAM_API_KEY=your-stream-api-key
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_TOKEN_KEY=your-token-authentication-key
